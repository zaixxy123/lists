local function GetSupportAutomationConfig(
    automationName
)
    local automation =
        type(StrategyConfig) == "table"
        and type(StrategyConfig.Towers) == "table"
        and type(StrategyConfig.Towers.Automation) == "table"
        and StrategyConfig.Towers.Automation
        or {}

    local config =
        automation[
            automationName
        ]

    return type(config) == "table"
        and config
        or {}
end

local function GetSupportTowers(
    towerName,
    minUpgrade
)
    local result = {}
    local towersFolder =
        workspace:FindFirstChild(
            "Towers"
        )

    if not towersFolder then
        return result
    end

    for _, towerRep in ipairs(
        towersFolder:GetDescendants()
    ) do
        if towerRep:IsA("Folder")
            and towerRep.Name == "TowerReplicator"
            and towerRep:GetAttribute("Name") == towerName
            and towerRep:GetAttribute("OwnerId") == plr.UserId
            and (
                tonumber(
                    towerRep:GetAttribute(
                        "Upgrade"
                    )
                )
                or 0
            ) >= minUpgrade then

            result[
                #result + 1
            ] = towerRep.Parent
        end
    end

    return result
end

local function GetCommanderChainDelay(
    interval
)
    local hotbar =
        PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        )

    local frame =
        hotbar
        and hotbar:FindFirstChild(
            "Frame"
        )

    local timescale =
        frame
        and frame:FindFirstChild(
            "timescale"
        )

    if timescale
        and timescale.Visible
        and not timescale:FindFirstChild(
            "Lock"
        ) then

        return interval / 2
    end

    return interval
end

local function StartAutoCommanderChain()
    if SupportAutomationRunning.AutoChain
        or TDS.HasCommander ~= true then

        return
    end

    local config =
        GetSupportAutomationConfig(
            "AutoChain"
        )

    local towerName =
        tostring(
            config.Tower
            or "Commander"
        )

    local abilityName =
        tostring(
            config.Ability
            or "Call Of Arms"
        )

    local minUpgrade =
        tonumber(
            config.MinUpgrade
        )
        or 2

    local interval =
        math.max(
            0.1,
            tonumber(config.Interval) or 10.5
        )

    local cooldown =
        math.max(
            0,
            tonumber(config.Cooldown) or 30
        )

    SupportAutomationRunning.AutoChain = true

    task.spawn(function()
        local index = 1
        local lastUsed = {}

        while IsStrategyRuntimeEnabled()
            and TDS.HasCommander == true do

            local commanders =
                GetSupportTowers(
                    towerName,
                    minUpgrade
                )

            if #commanders > 0 then
                if index > #commanders then
                    index = 1
                end

                local commander =
                    commanders[index]

                index = index % #commanders + 1

                local usedAt =
                    lastUsed[commander]

                local ready =
                    usedAt == nil
                    or os.clock() - usedAt
                        >= GetCommanderChainDelay(
                            cooldown
                        )

                if ready then
                    local commanderRep = commander:FindFirstChild("TowerReplicator")
                    if commanderRep
                        and (tonumber(commanderRep:GetAttribute("Upgrade")) or 0) >= 4
                        and getgenv().SupportCaravan ~= false then
                        pcall(function()
                            rf:InvokeServer("Troops", "Abilities", "Activate", {
                                Troop = commander,
                                Name = "Support Caravan",
                                Data = {}
                            })
                        end)
                    end
                    local ok, result =
                        pcall(function()
                            return rf:InvokeServer(
                                "Troops",
                                "Abilities",
                                "Activate",
                                {
                                    Troop = commander,
                                    Name = abilityName,
                                    Data = {}
                                }
                            )
                        end)

                    -- Commander ability replies can be truthy
                    -- without matching DirectResponseOK.
                    local accepted =
                        ok
                        and result ~= nil
                        and result ~= false
                        and not (
                            type(result) == "table"
                            and result.Success == false
                        )

                    if accepted then
                        lastUsed[commander] =
                            os.clock()

                        task.wait(
                            GetCommanderChainDelay(
                                interval
                            )
                        )
                    else
                        task.wait(0.25)
                    end
                else
                    task.wait(0.1)
                end
            else
                index = 1
                task.wait(0.2)
            end
        end

        SupportAutomationRunning.AutoChain = false
    end)
end

