local function DirectGetCurrentWave()
    local label

    repeat
        local gameStateReplicator =
            GetDirectGameStateReplicator()

        if gameStateReplicator
            and gameStateReplicator:GetAttribute("GameOver") == true then

            return nil
        end

        local guiObject =
            PlayerGui:FindFirstChild(
                "ReactGameTopGameDisplay"
            )

        local frameObject =
            guiObject
            and guiObject:FindFirstChild("Frame")

        local waveObject =
            frameObject
            and frameObject:FindFirstChild("wave")

        local container =
            waveObject
            and waveObject:FindFirstChild("container")

        label =
            container
            and container:FindFirstChild("value")

        if not label then
            task.wait(0.2)
        end
    until label

    return tonumber(
        tostring(label.Text):match("(%d+)")
    ) or 0
end

local function ParseWaveTimer(timer)
    if type(timer) ~= "string" then
        return nil
    end

    local minutes, seconds = timer:match("^(%d%d):([0-5]%d)$")
    if minutes then
        return tonumber(minutes) * 60 + tonumber(seconds)
    end
end

local function DirectGetWaveTimerText()
    local hud = PlayerGui:FindFirstChild("ReactGameTopGameDisplay")
    local frame = hud and hud:FindFirstChild("Frame")
    local timer = frame and frame:FindFirstChild("waveTimer")
    local container = timer and timer:FindFirstChild("container")
    local label = container and container:FindFirstChild("value")
    return label and label.Text
end

local function DirectWaitForWave(target, targetSeconds)
    while IsStrategyRuntimeEnabled() do
        local currentWave =
            DirectGetCurrentWave()

        if currentWave and currentWave >= target then
            if targetSeconds == nil then
                return true
            end

            if currentWave > target then
                return false
            end

            local remaining = ParseWaveTimer(DirectGetWaveTimerText())
            if remaining and remaining <= targetSeconds then
                return true
            end
        end

        task.wait(0.25)
    end

    return false
end

