local NecroAutoRunning = false
local function GetNecroGraves(rep)
    local store = rep and rep:FindFirstChild("GraveStone")
    if not store then return 0, 0 end
    local max = tonumber(store:GetAttribute("Max_Graves"))
        or tonumber(rep:GetAttribute("Max_Graves"))
    local level = tonumber(rep:GetAttribute("Upgrade")) or 0
    if not max or max < 2 then
        max = level >= 4 and 9 or (level >= 2 and 6 or 3)
    end
    local count = 0
    for key, value in pairs(store:GetAttributes()) do
        if type(key) == "string" and #key > 20 then
            if tostring(value):find("Destroy") then
                store:SetAttribute(key, nil)
            else
                count += 1
            end
        end
    end
    return count, max
end
local function StartAutoNecromancer()
    if NecroAutoRunning or not TDS.HasNecromancer then return end
    NecroAutoRunning = true
    task.spawn(function()
        local lastUsed = {}
        while TDS.HasNecromancer and IsStrategyRuntimeEnabled() do
            local necros = GetSupportTowers("Necromancer", 0)
            if #necros == 0 then
                task.wait(0.5)
            else
                for _, tower in ipairs(necros) do
                    if not TDS.HasNecromancer or not IsStrategyRuntimeEnabled() then break end
                    local rep = tower:FindFirstChild("TowerReplicator")
                    local count, max = GetNecroGraves(rep)
                    local cooldown = tonumber(rep and rep:GetAttribute("AbilityDebounce")) or 5
                    local now = os.clock()
                    if max > 0 and count >= max
                        and (not lastUsed[tower] or now - lastUsed[tower] >= cooldown) then
                        local ok, result = pcall(function()
                            return rf:InvokeServer("Troops", "Abilities", "Activate", {
                                Troop = tower, Name = "Raise The Dead", Data = {}
                            })
                        end)
                        if ok and result ~= nil and result ~= false then
                            lastUsed[tower] = os.clock()
                        end
                    end
                end
                task.wait(0.2)
            end
        end
        NecroAutoRunning = false
    end)
end
