local function UpdateVIPAutoSkip()
    -- Tower XP uses the Auto Progress API, which owns the VIP setting.
    -- Never turn that setting off from this standalone API.
    if RuntimeGlobals.AutoFarmTowerXP == true then
        return
    end

    if RuntimeGlobals.AutoStrategyEnabled == true
        and RuntimeGlobals.AutoStrategyForceAutoSkip == true then

        return
    end

    if not VoteSkipConfigured then
        -- No vote range has been requested yet, so don't touch the setting.
        return
    end

    if VoteSkipAll then
        SetAutoSkip(true)
        return
    end

    local currentWave =
        TryGetCurrentWave()

    if not currentWave
        or currentWave <= 0 then

        SetAutoSkip(
            VoteSkipWaves[1] == true
        )

        return
    end

    SetAutoSkip(
        VoteSkipWaves[
            currentWave
        ] == true
    )
end

local function StartVIPVoteSkip()
    if VIPVoteSkipWorkerRunning then
        return
    end

    VIPVoteSkipWorkerRunning = true

    task.spawn(function()
        while IsStrategyRuntimeEnabled()
            and RuntimeGlobals.VIPVoteSkipVersion
                == VIPVoteSkipVersion do

            if VIPVoteSkipStartedUnderAutoStrategy
                and RuntimeGlobals.AutoStrategyEnabled ~= true then

                break
            end

            UpdateVIPAutoSkip()
            task.wait(0.1)
        end

        VIPVoteSkipWorkerRunning = false
    end)
end

if HasVIP
    and VIPVoteSkipStartedUnderAutoStrategy then

    StartVIPVoteSkip()
end

