local function GetLobbyBoardMaps()
    local boards

    local normalLobby =
        workspace:FindFirstChild(
            "IntermissionLobby"
        )

    if normalLobby then
        boards =
            normalLobby:FindFirstChild(
                "Boards"
            )
    end

    if not boards then
        local hardcoreLobby =
            workspace:FindFirstChild(
                "HardcoreIntermissionLobby"
            )

        if hardcoreLobby then
            boards =
                hardcoreLobby:FindFirstChild(
                    "Boards"
                )
        end
    end

    if not boards then
        return {}
    end

    local maps = {}

    for i = 1, 4 do
        local board =
            boards:FindFirstChild(
                "Board" .. i
            )

        if board then
            local hitboxes =
                board:FindFirstChild(
                    "Hitboxes"
                )

            local bottom =
                hitboxes
                and hitboxes:FindFirstChild(
                    "Bottom"
                )

            local mapDisplay =
                bottom
                and bottom:FindFirstChild(
                    "MapDisplay"
                )

            local title =
                mapDisplay
                and mapDisplay:FindFirstChild(
                    "Title"
                )

            if title then
                maps[i] =
                    tostring(title.Text)
            end
        end
    end

    return maps
end

local function FindRequestedMap(mapName)
    mapName =
        tostring(
            mapName or ""
        )

    for _, currentMap in pairs(
        GetLobbyBoardMaps()
    ) do
        if tostring(currentMap) == mapName then
            return mapName
        end
    end

    return nil
end

local function StartMatchmakingPayload(payload)
    if type(payload) ~= "table" then
        return false
    end

    while true do
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(payload)
                )
            end)

        if ok
            and result ~= false then

            return true
        end

        task.wait(0.5)
    end
end

local function WaitForRequestedMapWithFallback(
    mapName,
    matchmaking
)
    mapName =
        tostring(
            mapName or ""
        )

    -- Let the boards finish populating first.
    task.wait(1)

    local selectedMap =
        FindRequestedMap(
            mapName
        )

    if selectedMap then
        return selectedMap, false
    end

    -- VIP/private servers can directly override to the requested map.
    if CanOverrideMap() then
        return mapName, false
    end

    -- Requested map is not on the boards:
    -- veto once and check the refreshed boards again.
    re:FireServer(
        "LobbyVoting",
        "Veto"
    )

    task.wait(0.5)

    selectedMap =
        FindRequestedMap(
            mapName
        )

    if selectedMap then
        return selectedMap, false
    end

    -- Still missing after the veto, so matchmake again
    -- using the mode saved by TDS:Mode().
    if StartMatchmakingPayload(
        matchmaking
    ) then
        return nil, true
    end

    return nil, false
end

local function DirectSelectMap(mapName)
    if CanOverrideMap() then
        pcall(function()
            rf:InvokeServer(
