local function BuildMatchmakingPayload(
    difficulty
)
    difficulty =
        tostring(
            difficulty or ""
        )

    if difficulty == "Trial" then
        return {
            count = 1,
            mode = "Trials"
        }
    end

    -- Halloween 2026 Acts 1-4; night always matches the selected act.
    -- Supports both Hard (ActN) and Easy (ActNEasy).
    local actNumber =
        difficulty:match("^Act([1-4])$")
        or difficulty:match("^Act([1-4])Easy$")

    if actNumber then
        return {
            difficulty = difficulty,
            night = tonumber(actNumber),
            count = 1,
            mode = "halloween2026"
        }
    end

    local mappedMode =
        TDS.MatchmakingMap[
            difficulty
        ]

    if difficulty == "Hardcore" then
        return {
            mode = "hardcore",
            difficulty = "Easy",
            count = 1
        }
    end

    if difficulty == "Voidcore" then
        return {
            mode = "hardcore",
            difficulty = "Hard",
            count = 1
        }
    end

    if mappedMode then
        local payload = {
            mode = mappedMode,
            count = 1
        }

        if difficulty:match(
            "^Ducky"
        ) then
            payload.difficulty =
                difficulty:gsub(
                    "^Ducky",
                    ""
                )
        end

        return payload
    end

    return {
        difficulty = difficulty,
        mode = "survival",
        count = 1
    }
end

function TDS:Mode(difficulty)
    difficulty =
        tostring(
            difficulty or ""
        )

    if difficulty == "Hardcore Easy" then
        difficulty = "Hardcore"
    end

    self.SavedDifficulty =
        difficulty

    local globalEnv =
        (getgenv and getgenv())
        or _G

    globalEnv.AutoStrategyMode =
        difficulty

    self.SavedMatchmaking =
        BuildMatchmakingPayload(
            difficulty
        )

    local lobbyHud =
        PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        )

    local hotbar =
        PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        )

    -- In a match, Mode only remembers the selected mode.
    -- The strategy will continue into GameInfo().
    if not lobbyHud
        and hotbar then

        return false
    end

    if difficulty == "" then
        return false
    end

    if difficulty == "Trial" then
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        return ok
            and result ~= false
    end

    local frame =
        lobbyHud
        and lobbyHud:FindFirstChild(
            "Frame"
        )

    local matchmaking =
        frame
        and frame:FindFirstChild(
            "matchmaking"
        )

    if not matchmaking then
        return false
    end

    while true do
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        if ok
            and DirectResponseOK(result) then

            return true
        end

        -- Stop retrying once Roblox has already moved us
        -- out of the lobby.
        if not PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        ) then

            return true
        end

        task.wait(0.5)
    end
end

function TDS:GameInfo(mapName, modifiers)
    -- Trial mode has no map voting.
    -- Matchmaking already puts us into the Trial server, so skip
    -- ReactGameIntermission / map lookup / map vote completely.
    if self.SavedDifficulty == "Trial" then
        return true
    end

    -- Same strategy file can run in lobby and in-match.
    -- Do nothing here while matchmaking is still in the lobby.
    if PlayerGui:FindFirstChild(
        "ReactLobbyHud"
    )
        and not PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        ) then

        return false
    end

    local voteGui =
        PlayerGui:WaitForChild(
            "ReactGameIntermission",
            30
        )

    if not voteGui then
        return false
    end

    local frame =
        voteGui:WaitForChild(
            "Frame",
            5
        )

    if not frame then
        return false
    end

    mapName =
        tostring(
            mapName or ""
        )

    local selectedMap,
        rematching =
        WaitForRequestedMapWithFallback(
            mapName,
            self.SavedMatchmaking
        )

    if rematching then
        -- Prevent the rest of the strategy from running
        -- in the wrong server/map while matchmaking moves us.
        while true do
            task.wait(1)
        end
    end

    if not selectedMap then
        return false
    end

    if type(modifiers) == "table" then

        local votes = {}

        -- Supports both:
        -- {"HiddenEnemies", "Fog"}
        -- {HiddenEnemies = true, Fog = true, Glass = false}
        for key, value in pairs(modifiers) do
            if type(key) == "number" then
                if value ~= nil and value ~= false then
                    votes[tostring(value)] = true
                end
            elseif value == true then
                votes[tostring(key)] = true
            end
        end

        pcall(function()
            ReplicatedStorage
                :WaitForChild("Network")
                :WaitForChild("Modifiers")
                :WaitForChild(
                    "RF:BulkVoteModifiers"
                )
                :InvokeServer(votes)
        end)
    end

    return DirectSelectMap(
        selectedMap
    )
end

function TDS:VoteSkip(startWave, endWave)
    VoteSkipConfigured = true

    if startWave == nil and endWave == nil then
        VoteSkipAll = true

        if HasVIP then
            UpdateVIPAutoSkip()
            StartVIPVoteSkip()
        else
            StartDirectAutoSkip()
        end

        return true
    end

    startWave = tonumber(startWave)

    if not startWave then
        return false
    end

    if endWave == nil then
        endWave = startWave
    else
        endWave = tonumber(endWave)

        if not endWave then
            return false
        end
    end

    startWave = math.floor(startWave)
    endWave = math.floor(endWave)

    if endWave < startWave then
        startWave, endWave = endWave, startWave
    end

    for wave = startWave, endWave do
        VoteSkipWaves[wave] = true
    end

    if HasVIP then
        UpdateVIPAutoSkip()
        StartVIPVoteSkip()
    else
        StartDirectSelectiveSkip(
            VoteSkipWaves
        )
    end

    return true
end

