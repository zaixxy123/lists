-- DYNAMIC MATCHMAKING RESOLVER (ZERO HARDCODING - AUTO-UPDATING)
-- =========================================================================
local function BuildMatchmakingPayload(difficulty)
    difficulty = tostring(difficulty or "")
    local cleanQuery = string.lower(difficulty):gsub("%s+", ""):gsub("[%-_]", "")

    local mmFolder = ReplicatedStorage:FindFirstChild("Client")
        and ReplicatedStorage.Client:FindFirstChild("Interfaces")
        and ReplicatedStorage.Client.Interfaces:FindFirstChild("Lobby")
        and ReplicatedStorage.Client.Interfaces.Lobby:FindFirstChild("Components")
        and ReplicatedStorage.Client.Interfaces.Lobby.Components:FindFirstChild("NewMatchmaking")

    if not mmFolder then
        return { count = 1, mode = "survival", difficulty = difficulty ~= "" and difficulty or nil }
    end

    local MatchmakingModel = require(mmFolder.MatchmakingModel)
    local TrialDataMod = mmFolder:FindFirstChild("MatchmakingTrialData")

    -- 1. Gather all registered game modes from MatchmakingModel
    local allEntries = {}
    for _, modes in pairs(MatchmakingModel.MODE_GROUPS) do
        for _, entry in ipairs(modes) do
            table.insert(allEntries, entry)
        end
    end

    -- 2. Include live rotating Trial safely WITHOUT calling UI asset loaders
    if TrialDataMod then
        local ok, TD = pcall(require, TrialDataMod)
        if ok and type(TD) == "table" then
            local rotOk, rot = pcall(TD.getCurrentRotation)
            local trialName = (rotOk and type(rot) == "table" and rot.trialName) or "Trial"
            table.insert(allEntries, {
                id = "trial",
                title = trialName,
                tag = "Trial",
                queue = {
                    mode = "Trials",
                    requirements = {
                        maxPartySize = 4,
                        minLevel = 40
                    }
                }
            })
        end
    end

    -- 3. Exact & Normalized Match
    for _, entry in ipairs(allEntries) do
        local q = entry.queue or {}
        local id = string.lower(entry.id or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local title = string.lower(entry.title or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local diff = string.lower(q.difficulty or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local mode = string.lower(q.mode or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local tag = string.lower(entry.tag or ""):gsub("%s+", ""):gsub("[%-_]", "")

        if diff == cleanQuery or title == cleanQuery or id == cleanQuery or mode == cleanQuery or tag == cleanQuery then
            return {
                count = 1,
                mode = q.mode,
                difficulty = q.difficulty,
                night = q.night
            }
        end
    end

    -- 4. Fuzzy Substring Match (handles "Badlands", "PollutedWasteland", "Act4", etc.)
    for _, entry in ipairs(allEntries) do
        local q = entry.queue or {}
        local id = string.lower(entry.id or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local title = string.lower(entry.title or ""):gsub("%s+", ""):gsub("[%-_]", "")
        local diff = string.lower(q.difficulty or ""):gsub("%s+", ""):gsub("[%-_]", "")

        if string.find(id, cleanQuery, 1, true) or string.find(title, cleanQuery, 1, true)
            or string.find(cleanQuery, id, 1, true) or string.find(cleanQuery, title, 1, true)
            or (diff ~= "" and string.find(diff, cleanQuery, 1, true)) then
            return {
                count = 1,
                mode = q.mode,
                difficulty = q.difficulty,
                night = q.night
            }
        end
    end

    -- 5. Safe Fallback
    return {
        count = 1,
        mode = "survival",
        difficulty = difficulty ~= "" and difficulty or nil
    }
end

local Act4PuzzleScheduled = false

local function ScheduleAct4Puzzle()
    if Act4PuzzleScheduled or game.PlaceId == LOBBY_PLACE_ID then
        return
    end

    Act4PuzzleScheduled = true
    task.spawn(function()
        local stateReplicators = ReplicatedStorage:WaitForChild("StateReplicators", 30)
        local state = stateReplicators and stateReplicators:WaitForChild("GameStateReplicator", 30)
        if not state then
            warn("[apis2] Act4 puzzle: game state not found")
            return
        end

        while state.Parent
            and state:GetAttribute("GameStarted") ~= true
            and state:GetAttribute("GameOver") ~= true
            and TDS.SavedDifficulty == "Act4" do
            task.wait(0.2)
        end

        if not state.Parent or state:GetAttribute("GameStarted") ~= true
            or state:GetAttribute("GameOver") == true
            or TDS.SavedDifficulty ~= "Act4" then
            return
        end

        local globals = getgenv()
        if type(globals._MoonPuzzleCleanup) == "function" then return end

        local ok, err = pcall(function()
            local source = game:HttpGet(
                "https://raw.githubusercontent.com/zaixxy123/lists/refs/heads/main/puzzle.lua"
            )
            local chunk, compileError = loadstring(source)
            if not chunk then error(compileError) end
            chunk()
        end)

        if not ok then
            warn("[apis2] Failed to load Act4 puzzle:", err)
        end
    end)
end

function TDS:Mode(difficulty)
    difficulty =
        tostring(
            difficulty or ""
        )

    if difficulty == "Hardcore Easy" then
        difficulty = "Hardcore"
    end

    self.SavedDifficulty =
        difficulty

    local globalEnv =
        (getgenv and getgenv())
        or _G

    globalEnv.AutoStrategyMode =
        difficulty

    self.SavedMatchmaking =
        BuildMatchmakingPayload(
            difficulty
        )

    if difficulty == "Act4" then
        ScheduleAct4Puzzle()
    end

    local lobbyHud =
        PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        )

    local hotbar =
        PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        )

    if not lobbyHud
        and hotbar then

        return false
    end

    if difficulty == "" then
        return false
    end

    if difficulty == "Trial" then
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        return ok
            and result ~= false
    end

    local frame =
        lobbyHud
        and lobbyHud:FindFirstChild(
            "Frame"
        )

    local matchmaking =
        frame
        and frame:FindFirstChild(
            "matchmaking"
        )

    if not matchmaking then
        return false
    end

    while true do
        local ok, result =
            pcall(function()
                return rf:InvokeServer(
                    "Multiplayer",
                    "v2:start",
                    table.clone(
                        self.SavedMatchmaking
                    )
                )
            end)

        if ok
            and DirectResponseOK(result) then

            return true
        end

        if not PlayerGui:FindFirstChild(
            "ReactLobbyHud"
        ) then

            return true
        end

        task.wait(0.5)
    end
end

function TDS:GameInfo(mapName, modifiers)
    if self.SavedDifficulty == "Trial" then
        return true
    end

    if PlayerGui:FindFirstChild(
        "ReactLobbyHud"
    )
        and not PlayerGui:FindFirstChild(
            "ReactUniversalHotbar"
        ) then

        return false
    end

    local voteGui =
        PlayerGui:WaitForChild(
            "ReactGameIntermission",
            30
        )

    if not voteGui then
        return false
    end

    local frame =
        voteGui:WaitForChild(
            "Frame",
            5
        )

    if not frame then
        return false
    end

    mapName =
        tostring(
            mapName or ""
        )

    local selectedMap,
        rematching =
        WaitForRequestedMapWithFallback(
            mapName,
            self.SavedMatchmaking
        )

    if rematching then
        while true do
            task.wait(1)
        end
    end

    if not selectedMap then
        return false
    end

    if type(modifiers) == "table" then

        local votes = {}

        for key, value in pairs(modifiers) do
            if type(key) == "number" then
                if value ~= nil and value ~= false then
                    votes[tostring(value)] = true
                end
            elseif value == true then
                votes[tostring(key)] = true
            end
        end

        pcall(function()
            ReplicatedStorage
                :WaitForChild("Network")
                :WaitForChild("Modifiers")
                :WaitForChild(
                    "RF:BulkVoteModifiers"
                )
                :InvokeServer(votes)
        end)
    end

    return DirectSelectMap(
        selectedMap
    )
end

function TDS:VoteSkip(startWave, endWave)
    if startWave == nil and endWave == nil then
        VoteSkipAll = true

        if HasVIP then
            RecordVIPVoteSkip("all waves")
        else
            StartDirectAutoSkip()
        end

        return true
    end

    startWave = tonumber(startWave)

    if not startWave then
        return false
    end

    if endWave == nil then
        endWave = startWave
    else
        endWave = tonumber(endWave)

        if not endWave then
            return false
        end
    end

    startWave = math.floor(startWave)
    endWave = math.floor(endWave)

    if endWave < startWave then
        startWave, endWave = endWave, startWave
    end

    for wave = startWave, endWave do
        VoteSkipWaves[wave] = true
    end

    if HasVIP then
        RecordVIPVoteSkip(("waves %d through %d"):format(startWave, endWave))
    else
        StartDirectSelectiveSkip(
            VoteSkipWaves
        )
    end

    return true
end

