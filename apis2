local function HasLoadoutTower(
    loadout,
    wantedTower
)
    wantedTower =
        tostring(
            wantedTower or ""
        )

    for _, towerName in ipairs(loadout) do
        if tostring(towerName) == wantedTower then
            return true
        end
    end

    return false
