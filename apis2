local function EnsureSkipWorker()
    if SkipWorkerRunning then
        return
    end

    SkipWorkerRunning = true

    task.spawn(function()
        while IsStrategyRuntimeEnabled() do
            local gameStateReplicator =
                GetDirectGameStateReplicator()

            if gameStateReplicator
                and gameStateReplicator:GetAttribute(
                    "GameOver"
                ) ~= true then

                local shouldSkip = false

                if SkipMode == "auto" then
                    shouldSkip = true
                elseif SkipMode == "selective" then
                    local currentWave =
                        DirectGetCurrentWave()

                    shouldSkip =
                        currentWave ~= nil
                        and ActiveSkipWaves[currentWave] == true
                end

                if shouldSkip
                    and IsVoteSkipButtonVisible() then

                    pcall(function()
                        rf:InvokeServer(
                            "Voting",
                            "Skip"
                        )
                    end)

                    task.wait(0.2)
                else
                    task.wait(0.1)
                end
            else
                task.wait(0.2)
            end
        end

        SkipWorkerRunning = false
    end)
end

local function StartDirectAutoSkip()
    SkipMode = "auto"
    EnsureSkipWorker()
end

local function StartDirectSelectiveSkip(skipWaves)
    ActiveSkipWaves =
        skipWaves or VoteSkipWaves

    SkipMode = "selective"
    EnsureSkipWorker()
end

