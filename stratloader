    local function SetStatus(_text)
        -- Status UI removed.
    end

    local function UpdateMainStatus(text)
        text = tostring(text)

        local cleanText =
            text:gsub(
                "^Status:%s*",
                ""
            )

        Globals.__RyaAutoStrategyStatus =
            cleanText

        if AutoStrategy
            and AutoStrategy.SetStatus then

            pcall(function()
                AutoStrategy:SetStatus(
                    cleanText
                )
            end)
        end

        if type(SetMainStatus) == "function" then
            pcall(
                SetMainStatus,
                text
            )
        end
    end

    local function Notify(content, duration)
        Library:Notify({
            Title = "Auto Strategy",
            Content = tostring(content),
            Duration = duration or 3
        })
    end

    local function IsSupportedFile(path)
        path =
            tostring(
                path or ""
            ):lower()

        return
            path:sub(-4) == ".lua"
            or path:sub(-5) == ".luau"
            or path:sub(-4) == ".txt"
    end

    local function GetFileName(path)
        path =
            tostring(
                path or ""
            )

        return
            path:match(
                "([^/\\]+)$"
            )
            or path
    end

    local function TransformStrategySource(source)
        source =
            tostring(
                source or ""
            )

        local output = {}

        for line in (
            source .. "\n"
        ):gmatch("(.-)\r?\n") do
            local trimmed =
                line:match(
                    "^%s*(.-)%s*$"
                )
                or line

            local isGlobalAssignment =
                trimmed:match(
                    "^_G%.[%w_]+%s*="
                ) ~= nil

            if not isGlobalAssignment then
                output[#output + 1] =
                    line
            end
        end

        source =
            table.concat(
                output,
                "\n"
            )

        local function ReplacePlain(text, oldValue, newValue)
            local startIndex =
                string.find(
                    text,
                    oldValue,
                    1,
                    true
                )

            while startIndex do
                text =
                    text:sub(
                        1,
                        startIndex - 1
                    )
                    .. newValue
                    .. text:sub(
                        startIndex
                        + #oldValue
                    )

                startIndex =
                    string.find(
                        text,
                        oldValue,
                        startIndex
                        + #newValue,
                        true
                    )
            end

            return text
        end

        for _, libraryUrl in ipairs(
            ORIGINAL_TDS_LIBRARIES
        ) do
            source =
                ReplacePlain(
                    source,
                    libraryUrl,
                    AUTO_PROGRESS_TDS_LIBRARY
                )
        end

        return source
    end

    local function EnsureFolder()
        if type(isfolder) == "function" then
            local ok, exists =
                pcall(
                    isfolder,
                    WORKSPACE_FOLDER
                )

            if ok
                and exists then

                return true
            end
        end

        if type(makefolder) == "function" then
            local ok =
                pcall(
                    makefolder,
                    WORKSPACE_FOLDER
                )

            if ok then
                return true
            end
        end

        return false
    end

    local function ScanFiles()
        if type(listfiles) ~= "function" then
            return nil,
                "listfiles is not supported by this executor"
        end

        EnsureFolder()

        local ok, files =
            pcall(function()
                return listfiles(
                    WORKSPACE_FOLDER
                )
            end)

        if not ok
            or type(files) ~= "table" then

            return nil,
                tostring(files)
        end

        local results = {}

        for _, path in ipairs(files) do
            local isFile = true

            if type(isfile) == "function" then
                local fileOk, fileResult =
                    pcall(
                        isfile,
                        path
                    )

                isFile =
                    fileOk
                    and fileResult == true

            elseif type(isfolder) == "function" then
                local folderOk, folderResult =
                    pcall(
                        isfolder,
                        path
                    )

                if folderOk
                    and folderResult == true then

                    isFile = false
                end
            end

            if isFile
                and IsSupportedFile(path) then

                results[#results + 1] =
                    tostring(path)
            end
        end

        table.sort(
            results,
            function(a, b)
                return
                    string.lower(a)
                    < string.lower(b)
            end
        )

        return results
    end

    local FilePathByName = {}

    local function BuildDisplayFiles(files)
        for key in pairs(
            FilePathByName
        ) do
            FilePathByName[key] = nil
        end

        local displayFiles = {}

        for _, path in ipairs(
            files or {}
        ) do
            local fileName =
                GetFileName(path)

            FilePathByName[fileName] =
                tostring(path)

            displayFiles[
                #displayFiles + 1
            ] = fileName
        end

        return displayFiles
    end

    local InitialFiles =
        ScanFiles()

    local InitialDisplayFiles =
        type(InitialFiles) == "table"
        and BuildDisplayFiles(
            InitialFiles
        )
        or nil

    if type(InitialFiles) == "table"
        and #InitialFiles > 0 then

        local savedPath =
            tostring(
                Saved.SelectedFile or ""
            )

        if savedPath ~= ""
            and type(isfile) == "function"
            and isfile(savedPath)
            and IsSupportedFile(savedPath) then

            SelectedStrategyFile =
                savedPath
        else
            SelectedStrategyFile =
                InitialFiles[1]

            Saved.SelectedFile =
                SelectedStrategyFile

            Save()
        end
    end

    local selectedDisplayValue = nil

    if SelectedStrategyFile then
        selectedDisplayValue =
            GetFileName(
                SelectedStrategyFile
            )
    end

    local StrategyDropdown =
        AutoStrategy:Dropdown({
            Title = "Strategy File",
            Desc = "Select a strategy file from Workspace/Auto Strategy",
            List =
                type(InitialDisplayFiles) == "table"
                and #InitialDisplayFiles > 0
                and InitialDisplayFiles
                or {
                    "<no files found>"
                },
            Value =
                selectedDisplayValue,
            Searchable = true,
            Callback = function(value)
                local selected =
                    type(value) == "table"
                    and value[1]
                    or value

                if selected
                    and selected ~= "<no files found>" then

                    local fileName =
                        tostring(selected)

                    SelectedStrategyFile =
                        FilePathByName[
                            fileName
                        ]

                    if SelectedStrategyFile then
                        Saved.SelectedFile =
                            SelectedStrategyFile

                        Save()

                        if Globals.__RyaAutoStrategyEnabled == true
                            and RunningStrategyFile then

                            if IsLobby() then
                                PendingStrategyChange = false
                                RunningStrategyFile =
                                    SelectedStrategyFile

                                UpdateMainStatus(
                                    "Status: Running Auto Strategy"
                                )
                            else
                                PendingStrategyChange =
                                    SelectedStrategyFile
                                    ~= RunningStrategyFile

                                if PendingStrategyChange then
                                    UpdateMainStatus(
                                        "Status: Strategy Changed Waiting Game to finish"
                                    )
                                else
                                    UpdateMainStatus(
                                        "Status: Running Auto Strategy"
                                    )
                                end
                            end
                        end

                        SetStatus(
                            "Selected "
                            .. fileName
                        )
                    end
                else
                    SelectedStrategyFile = nil
                end
            end
        })

    local function SetDropdownValues(values)
        if StrategyDropdown.SetValues then
            StrategyDropdown:SetValues(
                values
            )
        elseif StrategyDropdown.SetList then
            StrategyDropdown:SetList(
                values
            )
        end
    end

    local function SetDropdownValue(value)
        if StrategyDropdown.SetValue then
            StrategyDropdown:SetValue(
                value
            )
        elseif StrategyDropdown.Set then
            StrategyDropdown:Set(
                value
            )
        end
    end

    local RefreshingFiles = false
    local LastDisplaySignature = ""

    local function RefreshFiles()
        if RefreshingFiles then
            return false
        end

        RefreshingFiles = true

        task.spawn(function()
            local files, err =
                ScanFiles()

            if not files then
                Notify(
                    "Workspace scan failed: "
                    .. tostring(err),
                    5
                )

                RefreshingFiles = false
                return
            end

            if #files == 0 then
                SelectedStrategyFile = nil
                Saved.SelectedFile = ""
                Save()

                local signature =
                    "<no files found>"

                if signature ~= LastDisplaySignature then
                    SetDropdownValues({
                        "<no files found>"
                    })

                    LastDisplaySignature =
                        signature
                end

                RefreshingFiles = false
                return
            end

            local displayFiles =
                BuildDisplayFiles(
                    files
                )

            local signature =
                table.concat(
                    displayFiles,
                    "\0"
                )

            if signature ~= LastDisplaySignature then
                SetDropdownValues(
                    displayFiles
                )

                LastDisplaySignature =
                    signature
            end

            local running =
                Globals.__RyaAutoStrategyEnabled == true

            local keepCurrent =
                SelectedStrategyFile
                and (
                    running
                    or (
                        type(isfile) == "function"
                        and isfile(
                            SelectedStrategyFile
                        )
                    )
                )

            if not keepCurrent then
                SelectedStrategyFile =
                    files[1]
            end

            Saved.SelectedFile =
                SelectedStrategyFile

            Save()

            -- While a strategy is running, refresh only the list.
            -- Never auto-switch the selected/running strategy.
            if not running then
                SetDropdownValue(
                    GetFileName(
                        SelectedStrategyFile
                    )
                )
            end

            RefreshingFiles = false
        end)

        return true
    end

    -- Seed signature so the first manual refresh does not rebuild
    -- the dropdown when nothing changed.
    if type(InitialDisplayFiles) == "table" then
        LastDisplaySignature =
            table.concat(
                InitialDisplayFiles,
                "\0"
            )
    end

    local IgnoreAutoStrategyToggleCallbacks = 0

    local function SetToggleVisual(value)
        if not AutoStrategyToggle then
            return
        end

        IgnoreAutoStrategyToggleCallbacks += 1

        pcall(function()
            if AutoStrategyToggle.SetValue then
                AutoStrategyToggle:SetValue(
                    value
                )
            elseif AutoStrategyToggle.Set then
                AutoStrategyToggle:Set(
                    value
                )
            end
        end)

        task.defer(function()
            IgnoreAutoStrategyToggleCallbacks =
                math.max(
                    IgnoreAutoStrategyToggleCallbacks - 1,
                    0
                )
        end)
    end

    local function Stop()
        Globals.__RyaAutoStrategyEnabled = false
        Globals.__RyaAutoStrategyStatus = nil
        Saved.Enabled = false
        PendingStrategyChange = false
        RunningStrategyFile = nil
        Save()

        UpdateMainStatus(
            "Status: Idle"
        )

        Globals.__RyaAutoStrategyStatus = nil

        if AutoStrategyThread then
            pcall(function()
                task.cancel(
                    AutoStrategyThread
                )
            end)

            AutoStrategyThread = nil
        end

        SetStatus(
            "Stopped"
        )

        return true
    end

    Globals.SetAutoStrategyToggleVisual =
        SetToggleVisual

    Globals.AutoStrategySetDesiredEnabled =
        function(value)
            Saved.Enabled = value == true
            Save()

            task.defer(function()
                SetToggleVisual(
                    Saved.Enabled
                )
            end)

            return true
        end

    Globals.AutoStrategyStopForSwitch =
        Stop

    local function Start()
        if type(CanEnable) == "function" then
            local ok, allowed, message =
                pcall(
                    CanEnable
                )

            if not ok
                or allowed == false then

                if ok
                    and tostring(message or "")
                        == "__RYA_PENDING_SWITCH__" then

                    Saved.Enabled = true
                    Save()

                    task.defer(function()
                        SetToggleVisual(true)
                    end)

                    UpdateMainStatus(
                        tostring(
                            Globals.__RyaAutoFarmTransitionStatus
                            or "Status: Changed to Auto Strategy - Waiting for Current Game to Finish..."
                        )
                    )

                    return true
                end

                Notify(
                    tostring(
                        message
                        or "Unable to start Auto Strategy."
                    ),
                    5
                )

                return false
            end
        end

        local path =
            SelectedStrategyFile

        if not path
            or path == "" then

            SetStatus(
                "Select a file first"
            )

            Notify(
                "Select a strategy file first."
            )

            return false
        end

        if type(readfile) ~= "function" then
            SetStatus(
                "readfile unsupported"
            )

            Notify(
                "readfile is not supported by this executor.",
                5
            )

            return false
        end

        local readOk, source =
            pcall(
                readfile,
                path
            )

        if not readOk then
            SetStatus(
                "Read failed"
            )

            Notify(
                "Failed to read file: "
                .. tostring(source),
                6
            )

            return false
        end

        source =
            TransformStrategySource(
                source
            )

        local chunk, compileError =
            loadstring(
                source,
                "=" .. path
            )

        if not chunk then
            SetStatus(
                "Compile error"
            )

            Notify(
                "Compile error: "
                .. tostring(compileError),
                8
            )

            return false
        end

        if AutoStrategyThread then
            pcall(function()
                task.cancel(
                    AutoStrategyThread
                )
            end)

            AutoStrategyThread = nil
        end

        Globals.__RyaAutoStrategyEnabled = true
        Saved.Enabled = true
        Saved.SelectedFile = path
        RunningStrategyFile = path
        PendingStrategyChange = false
        Save()

        StartProgressWebhook()

        UpdateMainStatus(
            "Status: Running Auto Strategy"
        )

        local fileName =
            GetFileName(
                path
            )

        SetStatus(
            "Running "
            .. fileName
        )

        AutoStrategyThread =
            task.spawn(function()
                local runOk, runError =
                    pcall(
                        chunk
                    )

                AutoStrategyThread = nil

                if Globals.__RyaAutoStrategyEnabled ~= true then
                    return
                end

                if not runOk then
                    Globals.__RyaAutoStrategyEnabled = false
                    Saved.Enabled = false
                    Save()

                    SetStatus(
                        "Runtime error"
                    )

                    Notify(
                        "Runtime error: "
                        .. tostring(runError),
                        8
                    )

                    task.defer(function()
                        SetToggleVisual(
                            false
                        )
                    end)

                    return
                end

                SetStatus(
                    "Loaded "
                    .. fileName
                )
            end)

        return true
    end

    task.spawn(function()
        while true do
            task.wait(2)

            if not RefreshingFiles then
                RefreshFiles()
            end
        end
    end)

