return function(Context)
    Context = type(Context) == "table" and Context or {}

    local Window = Context.Window
    local Library = Context.Library
    local Globals = Context.Globals or getgenv()
    local CanEnable = Context.CanEnable
    local RequestDisable = Context.RequestDisable
    local SetMainStatus = Context.SetMainStatus
    local BackToLobby = Context.BackToLobby
    local Players = game:GetService("Players")
    local HttpService = game:GetService("HttpService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local MarketplaceService = game:GetService("MarketplaceService")
    local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

    if not Window or not Library then
        return nil
    end

    local WORKSPACE_FOLDER = "AutoStrategy"
    local SETTINGS_FILE =
        "AutoProgress_" .. tostring(LocalPlayer.Name) .. ".json"

    local function IsLobby()
        local playerGui =
            LocalPlayer:FindFirstChild(
                "PlayerGui"
            )

        return playerGui
            and playerGui:FindFirstChild(
                "ReactLobbyHud"
            ) ~= nil
    end

    local ORIGINAL_TDS_LIBRARIES = {
        "https://f.spacehub.wtf/Scripts/TDS/Recorders/Library.lua",
        "https://getaether.cc/loader.lua",
        "https://raw.githubusercontent.com/DuxiiT/auto-strat/refs/heads/main/Library.lua",
        "https://raw.githubusercontent.com/DuxiiT/auto-strat/main/Library.lua",
    }

    local AUTO_PROGRESS_TDS_LIBRARY =
        "https://raw.githubusercontent.com/RyaaV2/lists/refs/heads/main/apis2"

    local PROGRESS_WEBHOOK_URL =
        "https://raw.githubusercontent.com/Ceepizz/WEBHOOKSOURCE/refs/heads/main/doakes"

    local function StartProgressWebhook()
        local webhook =
            type(shared.ProgressWebhook) == "table"
            and shared.ProgressWebhook
            or nil

        if not webhook then
            local ok, result =
                pcall(function()
                    return loadstring(
                        game:HttpGet(
                            PROGRESS_WEBHOOK_URL
                        )
                    )()
                end)

            if ok
                and type(result) == "table" then

                webhook = result
            elseif type(shared.ProgressWebhook) == "table" then
                webhook = shared.ProgressWebhook
            end
        end

        if not webhook then
            return false
        end

        local url =
            tostring(
                Globals.Webhook
                or Globals.WebhookURL
                or ""
            )

        if url ~= ""
            and webhook.SetWebhook then

            pcall(function()
                webhook.SetWebhook(url)
            end)
        end

        if webhook.Start then
            local ok, result =
                pcall(function()
                    return webhook.Start()
                end)

            return ok and result ~= false
        end

        return false
    end

    local Saved = {
        Enabled = false,
        AutoRestartStrategy = false,
        AutoSkipStrategy = false,
        SelectedFile = ""
    }

    local function LoadSaved()
        if type(isfile) ~= "function"
            or type(readfile) ~= "function"
            or not isfile(SETTINGS_FILE) then

            return
        end

        pcall(function()
            local data =
                HttpService:JSONDecode(
                    readfile(SETTINGS_FILE)
                )

            if type(data) ~= "table" then
                return
            end

            if type(data.AutoStrategyEnabled) == "boolean" then
                Saved.Enabled =
                    data.AutoStrategyEnabled
            end

            if type(data.AutoRestartStrategy) == "boolean" then
                Saved.AutoRestartStrategy =
                    data.AutoRestartStrategy
            end

            if type(data.AutoStrategyAutoSkip) == "boolean" then
                Saved.AutoSkipStrategy =
                    data.AutoStrategyAutoSkip
            end

            if type(data.AutoStrategySelectedFile) == "string" then
                Saved.SelectedFile =
                    data.AutoStrategySelectedFile
            end
        end)
    end

    local function Save()
        if type(writefile) ~= "function" then
            return
        end

        pcall(function()
            local data = {}

            if type(isfile) == "function"
                and type(readfile) == "function"
                and isfile(SETTINGS_FILE) then

                local ok, existing =
                    pcall(function()
                        return HttpService:JSONDecode(
                            readfile(SETTINGS_FILE)
                        )
                    end)

                if ok
                    and type(existing) == "table" then

                    data = existing
                end
            end

            data.AutoStrategyEnabled =
                Saved.Enabled == true

            data.AutoRestartStrategy =
                Saved.AutoRestartStrategy == true

            data.AutoStrategyAutoSkip =
                Saved.AutoSkipStrategy == true

            data.AutoStrategySelectedFile =
                tostring(
                    Saved.SelectedFile or ""
                )

            writefile(
                SETTINGS_FILE,
                HttpService:JSONEncode(
                    data
                )
            )
        end)
    end

    LoadSaved()

    Globals.__RyaAutoStrategyForceAutoSkip =
        Saved.AutoSkipStrategy == true

