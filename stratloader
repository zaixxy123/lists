    local function IsAutoSkipEnabled()
        local button =
            GetAutoSkipButton()

        if not button then
            return nil
        end

        local contentText =
            button:FindFirstChild(
                "contentText"
            )

        if not contentText then
            return nil
        end

        local state =
            tostring(
                contentText.Text
            ):lower()

        if state == "enabled" then
            return true
        end

        if state == "disabled" then
            return false
        end

        return nil
    end

    local AutoSkipPendingState = nil
    local AutoSkipLastClickAt = 0

    local function ToggleAutoSkip()
        local button =
            GetAutoSkipButton()

        if not button
            or type(getconnections) ~= "function" then

            return false
        end

        local downConnections =
            getconnections(
                button.MouseButton1Down
            )

        local upConnections =
            getconnections(
                button.MouseButton1Up
            )

        if #downConnections == 0
            or #upConnections == 0 then

            return false
        end

        for _, connection in ipairs(
            downConnections
        ) do
            pcall(function()
                connection.Function()
            end)
        end

        task.wait(0.05)

        for _, connection in ipairs(
            upConnections
        ) do
            pcall(function()
                connection.Function()
            end)
        end

        return true
    end

    local function SetAutoSkip(enabled)
        enabled = enabled == true

        local current =
            IsAutoSkipEnabled()

        if current == nil then
            return false
        end

        if current == enabled then
            AutoSkipPendingState = nil
            return true
        end

        if AutoSkipPendingState == enabled
            and os.clock() - AutoSkipLastClickAt < 0.5 then

            return false
        end

        AutoSkipPendingState = enabled
        AutoSkipLastClickAt = os.clock()

        if not ToggleAutoSkip() then
            AutoSkipPendingState = nil
            return false
        end

        task.wait(0.15)

        current =
            IsAutoSkipEnabled()

        if current == enabled then
            AutoSkipPendingState = nil
            return true
        end

        return false
    end

    local function IsVoteSkipButtonVisible()
        local playerGui =
            LocalPlayer:FindFirstChild(
                "PlayerGui"
            )

        local voteGui =
            playerGui
            and playerGui:FindFirstChild(
                "ReactOverridesVote"
            )

        local frameObject =
            voteGui
            and voteGui:FindFirstChild(
                "Frame"
            )

        local votes =
            frameObject
            and frameObject:FindFirstChild(
                "votes"
            )

        local voteButton =
            votes
            and votes:FindFirstChild(
                "vote"
            )

        return voteButton
            and voteButton.Position
                == UDim2.new(
                    0.5,
                    0,
                    0.5,
                    0
                )
    end

    task.spawn(function()
        local vipApplied = false

        while true do
            task.wait(0.1)

            local autoStrategyEnabled =
                Globals.__RyaAutoStrategyEnabled == true

            if not autoStrategyEnabled then
                if vipApplied then
                    SetAutoSkip(false)
                end

                vipApplied = false
                continue
            end

            local enabled =
                Saved.AutoSkipStrategy == true

            if HasVIP then
                if enabled then
                    if not vipApplied
                        or IsAutoSkipEnabled() ~= true then

                        if SetAutoSkip(true) then
                            vipApplied = true
                        end
                    end
                else
                    if vipApplied then
                        SetAutoSkip(false)
                    end

                    vipApplied = false
                end

                continue
            end

            if not enabled then
                continue
            end

            local rep =
                GetGameStateReplicator()

            if rep
                and rep:GetAttribute(
                    "GameOver"
                ) ~= true
                and IsVoteSkipButtonVisible() then

                pcall(function()
                    ReplicatedStorage
                        :WaitForChild(
                            "RemoteFunction"
                        )
                        :InvokeServer(
                            "Voting",
                            "Skip"
                        )
                end)

                task.wait(0.2)
            end
        end
    end)

    local function ReturnToLobbyForStrategyChange()
        if ReturnToLobbyInProgress
            or PendingStrategyChange ~= true
            or Globals.__RyaAutoStrategyEnabled ~= true then

            return false
        end

        ReturnToLobbyInProgress = true

        UpdateMainStatus(
            "Status: Returning to Lobby..."
        )

        if AutoStrategyThread then
            pcall(function()
                task.cancel(
                    AutoStrategyThread
                )
            end)

            AutoStrategyThread = nil
        end

        -- The main BackToLobby() uses FindFirstChild(), so if this runs
        -- before the end-screen Teleport remote exists it can silently miss it.
        -- Tower XP naturally waits longer because it refreshes the tower level
        -- before returning. Wait for the exact same BackToLobby remote here.
        local deadline =
            os.clock() + 10

        local backToLobbyRemote = nil

        repeat
            local network =
                ReplicatedStorage:FindFirstChild(
                    "Network"
                )

            local teleportFolder =
                network
                and network:FindFirstChild(
                    "Teleport"
                )

            backToLobbyRemote =
                teleportFolder
                and teleportFolder:FindFirstChild(
                    "RE:backToLobby"
                )

            if backToLobbyRemote then
                break
            end

            task.wait(0.1)
        until os.clock() >= deadline

        if not backToLobbyRemote then
            ReturnToLobbyInProgress = false
            return false
        end

        task.spawn(function()
            local fireDeadline =
                os.clock() + 8

            repeat
                pcall(function()
                    backToLobbyRemote:FireServer()
                end)

                task.wait(0.75)

                if IsLobby() then
                    return
                end
            until os.clock() >= fireDeadline

            ReturnToLobbyInProgress = false
        end)

        return true
    end

    local function RematchAndRerun()
        if RestartInProgress
            or Saved.AutoRestartStrategy ~= true
            or Globals.__RyaAutoStrategyEnabled ~= true then

            return false
        end

        RestartInProgress = true

        local gameOverRep =
            GetGameStateReplicator()

        local health =
            gameOverRep
            and tonumber(
                gameOverRep:GetAttribute(
                    "Health"
                )
            )
            or 0

        local won =
            health > 0

        UpdateMainStatus(
            won
            and "Status: Rematching..."
            or "Status: Restarting Match..."
        )

        local ok, result =
            pcall(function()
                if won then
                    -- Win/Triumph: use RE:Rematch once.
                    local rematchEvent =
                        ReplicatedStorage
                            :WaitForChild("Network")
                            :WaitForChild("GameManager")
                            :WaitForChild("RE:Rematch")

                    rematchEvent:FireServer()

                    local timeoutAt =
                        os.clock() + 30

                    repeat
                        if Saved.AutoRestartStrategy ~= true
                            or Globals.__RyaAutoStrategyEnabled ~= true then

                            return false
                        end

                        local rep =
                            GetGameStateReplicator()

                        if rep
                            and rep:GetAttribute(
                                "GameOver"
                            ) == false then

                            return true
                        end

                        task.wait(0.1)
                    until os.clock() >= timeoutAt

                    return false
                end

                -- Loss: match the main Auto Progress logic.
                -- Use Voting/Skip only until GameOver becomes false.
                local remoteFunction =
                    ReplicatedStorage:WaitForChild(
                        "RemoteFunction"
                    )

                local timeoutAt =
                    os.clock() + 15

                repeat
                    if Saved.AutoRestartStrategy ~= true
                        or Globals.__RyaAutoStrategyEnabled ~= true then

                        return false
                    end

                    pcall(function()
                        remoteFunction:InvokeServer(
                            "Voting",
                            "Skip"
                        )
                    end)

                    local waitUntil =
                        os.clock() + 0.75

                    repeat
                        task.wait(0.1)

                        local rep =
                            GetGameStateReplicator()

                        if rep
                            and rep:GetAttribute(
                                "GameOver"
                            ) == false then

                            return true
                        end
                    until os.clock() >= waitUntil
                until os.clock() >= timeoutAt

                local rep =
                    GetGameStateReplicator()

                return rep
                    and rep:GetAttribute(
                        "GameOver"
                    ) == false
                    or false
            end)

        if not ok
            or result ~= true then

            RestartInProgress = false

            if Globals.__RyaAutoStrategyEnabled == true
                and Saved.AutoRestartStrategy == true then

                Notify(
                    "Auto Restart Strategy failed.",
                    5
                )
            end

            return false
        end

        local readyDeadline =
            os.clock() + 45

        UpdateMainStatus(
            "Status: Waiting for Ready..."
        )

        local readyReached =
            false

        repeat
            if Saved.AutoRestartStrategy ~= true
                or Globals.__RyaAutoStrategyEnabled ~= true then

                RestartInProgress = false
                return false
            end

            local rep =
                GetGameStateReplicator()

            local voteRep =
                GetVoteReplicator()

            if rep
                and rep:GetAttribute(
                    "GameStarted"
                ) == true then

                readyReached = true
                break
            end

            if voteRep
                and voteRep:GetAttribute(
                    "Enabled"
                ) == true
                and voteRep:GetAttribute(
                    "Title"
                ) == "Ready?" then

                readyReached = true
                break
            end

            task.wait(0.1)
        until os.clock() >= readyDeadline

        if not readyReached then
            RestartInProgress = false
            return false
        end

        -- Do NOT press Ready here. Start the strategy only once the
        -- Ready? prompt exists so the strategy's own TDS:Ready()
        -- handles the prompt at the correct point in the file.
        if Saved.AutoRestartStrategy == true
            and Globals.__RyaAutoStrategyEnabled == true then

            Start()
        end

        RestartInProgress = false
        return true
    end

    task.spawn(function()
        local lastRep = nil
        local lastGameOver = nil

        local function HandleGameOver()
            if Globals.__RyaAutoStrategyEnabled ~= true then
                return
            end

            if Globals.__RyaAutoFarmTransitionTarget ~= nil then
                return
            end

            if PendingStrategyChange == true then
                if not ReturnToLobbyInProgress then
                    task.spawn(
                        ReturnToLobbyForStrategyChange
                    )
                end

                return
            end

            if Saved.AutoRestartStrategy == true
                and not RestartInProgress then

                task.spawn(
                    RematchAndRerun
                )
            end
        end

        while true do
            task.wait(0.1)

            local rep =
                GetGameStateReplicator()

            if rep ~= lastRep then
                lastRep = rep

                lastGameOver =
                    rep
                    and rep:GetAttribute(
                        "GameOver"
                    ) == true
                    or nil

                if lastGameOver == true then
                    HandleGameOver()
                end

            elseif rep then
                local isGameOver =
                    rep:GetAttribute(
                        "GameOver"
                    ) == true

                if isGameOver == true
                    and lastGameOver ~= true then

                    HandleGameOver()
                end

                lastGameOver =
                    isGameOver
            else
                lastGameOver = nil
            end
        end
    end)

    AutoStrategyToggle =
        AutoStrategy:Toggle({
            Title = "Enable Auto Strategy",
            Desc = "Automatically runs the selected strategy file.",
            Value = Saved.Enabled == true,
            Callback = function(value)
                if IgnoreAutoStrategyToggleCallbacks > 0
                    or Globals.__RyaFarmToggleVisualSync == true then

                    return
                end

                if value then
                    if not Start() then
                        Globals.__RyaAutoStrategyEnabled = false
                        Saved.Enabled = false
                        Save()

                        task.defer(function()
                            SetToggleVisual(
                                false
                            )
                        end)
                    end
                else
                    if type(RequestDisable) == "function" then
                        local ok, handled =
                            pcall(
                                RequestDisable
                            )

                        if ok
                            and handled == true then

                            task.defer(function()
                                SetToggleVisual(
                                    true
                                )
                            end)

                            return
                        end
                    end

                    Stop()
                end
            end
        })

    AutoRestartStrategyToggle =
        AutoStrategy:Toggle({
            Title = "Auto Restart Strategy",
            Desc = "Rematches and reruns the selected strategy after Triumph or Loss.",
            Value = Saved.AutoRestartStrategy == true,
            Callback = function(value)
                Saved.AutoRestartStrategy =
                    value == true

                Save()
            end
        })

    AutoSkipStrategyToggle =
        AutoStrategy:Toggle({
            Title = "Auto Skip",
            Desc = "Automatically skip waves",
            Value = Saved.AutoSkipStrategy == true,
            Callback = function(value)
                Saved.AutoSkipStrategy =
                    value == true

                Globals.__RyaAutoStrategyForceAutoSkip =
                    Saved.AutoSkipStrategy == true

                Save()
            end
        })


    if SelectedStrategyFile then
        SetStatus(
            "Selected "
            .. GetFileName(
                SelectedStrategyFile
            )
        )
    elseif type(listfiles) ~= "function" then
        SetStatus(
            "listfiles unsupported"
        )
    else
        SetStatus(
            "No supported files found"
        )
    end

    if Saved.Enabled == true
        and SelectedStrategyFile then

        task.defer(function()
            task.wait(0.1)

            if Globals.__RyaAutoStrategyEnabled ~= true then
                Start()
            end
        end)
    end

    return {
        Start = Start,
        Stop = Stop,
        Refresh = RefreshFiles,
        IsEnabled = function()
            return Saved.Enabled == true
        end,
        GetSelectedFile = function()
            return SelectedStrategyFile
        end
    }
end
