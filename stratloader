    local AutoStrategyThread = nil
    local AutoStrategyToggle = nil
    local AutoRestartStrategyToggle = nil
    local AutoSkipStrategyToggle = nil
    local RestartInProgress = false
    local ReturnToLobbyInProgress = false
    local RunningStrategyFile = nil
    local PendingStrategyChange = false

